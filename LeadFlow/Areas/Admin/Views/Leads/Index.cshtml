@model LeadListViewModel
@using LeadFlow.Application.Leads
@using LeadFlow.Domain.Enums
@{
    ViewData["Title"] = "Заявки";
}

<section class="admin-page">
    <h1>Заявки</h1>

    <form method="get" class="lead-list-filters">
        <div class="form-field">
            <label for="status">Статус</label>
            <select id="status" name="status">
                <option value="">Все заявки</option>
                @foreach (var item in Enum.GetValues<LeadStatus>())
                {
                    if (Model.Status == item)
                    {
                        <option value="@item" selected>@GetStatusName(item)</option>
                    }
                    else
                    {
                        <option value="@item">@GetStatusName(item)</option>
                    }
                }
            </select>
        </div>
        <div class="form-field">
            <label for="sortOrder">Сортировка</label>
            <select id="sortOrder" name="sortOrder">
                @if (Model.SortOrder == LeadListSortOrder.NewestFirst)
                {
                    <option value="@LeadListSortOrder.NewestFirst" selected>Сначала новые</option>
                    <option value="@LeadListSortOrder.OldestFirst">Сначала старые</option>
                }
                else
                {
                    <option value="@LeadListSortOrder.NewestFirst">Сначала новые</option>
                    <option value="@LeadListSortOrder.OldestFirst" selected>Сначала старые</option>
                }
            </select>
        </div>
        <button type="submit">Применить</button>
    </form>

    @if (Model.Leads.Count == 0)
    {
        <p>Заявок пока нет.</p>
    }
    else
    {
        <div class="lead-list-wrapper">
            <table class="lead-list">
                <thead>
                    <tr>
                        <th>Имя</th>
                        <th>Телефон</th>
                        <th>Услуга</th>
                        <th>Дата создания</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in Model.Leads)
                    {
                        <tr>
                            <td>@lead.Name</td>
                            <td>@lead.Phone</td>
                            <td>@lead.Service</td>
                            <td>@lead.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@lead.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@functions {
    private static string GetStatusName(LeadStatus status) => status switch
    {
        LeadStatus.New => "Новая",
        LeadStatus.InProgress => "В работе",
        LeadStatus.Completed => "Выполнена",
        LeadStatus.Rejected => "Отказ",
        _ => status.ToString()
    };
}
